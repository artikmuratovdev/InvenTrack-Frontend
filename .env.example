# ========================================================
# InvenTrack - Muhit o'zgaruvchilari (Environment Variables)
# ========================================================

# --- GEMINI AI SOZLAMALARI ---
# Gemini AI chat yordamchisi uchun API kalit (Google AI Studio)
GEMINI_API_KEY=""

# --- FIREBASE FIRESTORE SOZLAMALARI ---
# Firestore-ni ulash uchun quyidagi 2 ta usuldan birini tanlang:

# 1-USUL: Alohida o'zgaruvchilar orqali (Tavsiya etiladi - Hosting va serverlar uchun qulay)
# Firebase Console -> Project Settings -> Service accounts -> "Generate new private key"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Eslatma: FIREBASE_PRIVATE_KEY odatda "-----BEGIN PRIVATE KEY-----\n..." ko'rinishida bo'ladi.
# \n belgilarini o'z holicha qoldirishingiz mumkin.

# 2-USUL: Service Account JSON fayli orqali
# Yuklab olingan json faylni loyiha ildiziga 'serviceAccountKey.json' nomi bilan qo'ying:
# FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# (Ixtiyoriy) Agar Firebase Emulator ishlatsangiz:
# FIRESTORE_EMULATOR_HOST="localhost:8080"

# --- SERVER SOZLAMALARI ---
PORT=3000
HOST="127.0.0.1"
JWT_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# Vercel production'da Firestore majburiy: local JSON fayllari doimiy saqlanmaydi.
# Vercel Project Settings -> Environment Variables bo'limida shu kalitlarni kiriting.
